# Base: LLVM with a 100-column budget and 4-space C++ indent (see .editorconfig).
# The agent never makes a formatting decision — `bin/fmt` decides, CI enforces.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBraces: Attach
FixNamespaceComments: true
IncludeBlocks: Regroup
IncludeCategories:
  # Own header first, then graph-lite (the boundary we care about), then the
  # rest of the repo, then the standard library.
  - Regex:    '^"graph-lite\.h"$'
    Priority: 2
  - Regex:    '^"(engine|analysis|daemon|cli)/'
    Priority: 3
  - Regex:    '^<[a-z_]+>$'
    Priority: 5
  - Regex:    '^<.*>$'
    Priority: 4
  - Regex:    '.*'
    Priority: 3
SortIncludes: CaseSensitive
SeparateDefinitionBlocks: Always
