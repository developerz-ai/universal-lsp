{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "sentry-mcp": {
      "type": "stdio",
      "command": "bunx",
      "args": ["@sentry/mcp-server@0.49.0"],
      "env": {
        "SENTRY_ACCESS_TOKEN": "${SENTRY_ACCESS_TOKEN}",
        "SENTRY_HOST": "${SENTRY_HOST}"
      }
    }
  }
}
